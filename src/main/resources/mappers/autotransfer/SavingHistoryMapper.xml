<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.jejuro.miraero.domain.autotransfer.mapper.SavingHistoryMapper">

    <!--
        INSERT IGNORE로 중복 실행을 DB가 막는다.
        배치가 두 번 돌거나 수동 실행과 겹쳐도 두 번 적립되지 않는다.
        auto_saving_id는 페이스메이커 적립에서만 채워지므로 여기서는 넣지 않는다.
    -->
    <insert id="insertIgnoreDuplicate">
        INSERT IGNORE INTO auto_saving_history
        (
            money_box_id,
            amount,
            transacted_at,
            transfer_status
        )
        VALUES
        (
            #{moneyBoxId},
            #{amount},
            #{transactedAt},
            #{transferStatus}
        )
    </insert>

</mapper>
